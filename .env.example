# Synthetic local development only; copy to untracked .env.
APP_ENV=development
AUTH_MODE=mock
INFERENCE_PROVIDER=disabled
DATABASE_URL=postgresql+psycopg://advisory_app:local-app-only@127.0.0.1:5432/advisory_dev
AUTH_DATABASE_URL=postgresql+psycopg://advisory_auth:local-auth-only@127.0.0.1:5432/advisory_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://advisory_migrator:local-migrations-only@127.0.0.1:5432/advisory_dev
# Replace with a local random value of at least 32 characters. Never reuse outside development.
IDENTITY_SIGNING_KEY=local-synthetic-only-replace-before-use
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
RECENT_AUTH_SECONDS=600
VERIFICATION_SECONDS=600
# Next.js reads this server-only variable; never prefix secrets with NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:8000
