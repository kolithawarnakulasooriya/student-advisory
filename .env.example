# Interface contract only. No application config loader exists yet.
# Copy to an untracked .env for local development only.
APP_ENV=development
AUTH_MODE=mock
INFERENCE_PROVIDER=mock
DATABASE_URL=postgresql+psycopg://advisory:local-only@127.0.0.1:5432/advisory
INSTITUTION_ID=synthetic-institution
SESSION_COOKIE_SECURE=false
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_SERVED_MODEL=advisory-chat
VLLM_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
EMBEDDING_MODEL=REPLACE_PINNED_EMBEDDING_MODEL
EMBEDDING_DIMENSION=REPLACE_MODEL_DIMENSION
GCP_PROJECT_ID=REPLACE_PROJECT_ID
GCP_REGION=REPLACE_REGION
SOURCE_QUARANTINE_BUCKET=REPLACE_PRIVATE_BUCKET
SOURCE_PUBLISHED_BUCKET=REPLACE_PRIVATE_BUCKET
FORM_ARTIFACT_BUCKET=REPLACE_PRIVATE_BUCKET
NOTIFICATION_PROVIDER=mock
# Production must reject mock auth/inference, insecure cookies, and missing secrets.
