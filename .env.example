# Synthetic local development only; copy to untracked .env.
APP_ENV=development
AUTH_MODE=mock
INFERENCE_PROVIDER=disabled
DATABASE_URL=postgresql+psycopg://advisory_app:local-app-only@127.0.0.1:5432/advisory_dev
AUTH_DATABASE_URL=postgresql+psycopg://advisory_auth:local-auth-only@127.0.0.1:5432/advisory_dev
MIGRATION_DATABASE_URL=postgresql+psycopg://advisory_migrator:local-migrations-only@127.0.0.1:5432/advisory_dev
# Replace with a local random value of at least 32 characters. Never reuse outside development.
IDENTITY_SIGNING_KEY=local-synthetic-only-replace-before-use
WEB_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
RECENT_AUTH_SECONDS=600
VERIFICATION_SECONDS=600
# Next.js reads this server-only variable; never prefix secrets with NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:8000

# Local invitation capture only; no relay or real email provider.
MAIL_DATABASE_URL=postgresql+psycopg://advisory_mail:local-mail-only@127.0.0.1:5432/advisory_dev
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
INVITATION_HOURS=48

# Local private intake. Keep paths outside frontend/public; defaults are local-data/.
INGEST_DATABASE_URL=postgresql+psycopg://advisory_ingest:local-ingest-only@127.0.0.1:5432/advisory_dev
PARSER_IMAGE=advisory-parser:0.3
MAX_UPLOAD_BYTES=26214400
PARSER_TIMEOUT_SECONDS=240

# Release 0.4: set INFERENCE_PROVIDER=ollama after preparing the private profile.
# mock is for deterministic tests only; disabled never silently substitutes a model.
RAG_DATABASE_URL=postgresql+psycopg://advisory_rag:local-rag-only@127.0.0.1:5432/advisory_dev
INFERENCE_GATEWAY_URL=http://127.0.0.1:11435
INFERENCE_TIMEOUT_SECONDS=180
# Token is loaded from ignored local-data/inference/gateway-token; do not commit it.
# vLLM contract alternative also requires loopback VLLM_URL, VLLM_MODEL and VLLM_TOKEN.
