{
  "components": {
    "schemas": {
      "CsrfOut": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut",
        "type": "object"
      },
      "EmailInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 6,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailInput",
        "type": "object"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "field_errors": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Field Errors",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorOut",
        "type": "object"
      },
      "GrantOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "institution_id": {
            "format": "uuid",
            "title": "Institution Id",
            "type": "string"
          },
          "org_unit_id": {
            "format": "uuid",
            "title": "Org Unit Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "student",
              "advisor",
              "secretary",
              "manager",
              "platform_admin",
              "super_admin"
            ],
            "title": "Role",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "institution_id",
          "org_unit_id",
          "role",
          "status"
        ],
        "title": "GrantOut",
        "type": "object"
      },
      "MeOut": {
        "properties": {
          "account_state": {
            "title": "Account State",
            "type": "string"
          },
          "active_grants": {
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            },
            "title": "Active Grants",
            "type": "array"
          },
          "active_scope": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Scope"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "grant_epoch": {
            "title": "Grant Epoch",
            "type": "integer"
          },
          "identity_mode": {
            "const": "synthetic",
            "default": "synthetic",
            "title": "Identity Mode",
            "type": "string"
          },
          "membership_state": {
            "title": "Membership State",
            "type": "string"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/GrantOut"
            },
            "title": "Memberships",
            "type": "array"
          },
          "mfa_required": {
            "title": "Mfa Required",
            "type": "boolean"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "recent_auth": {
            "title": "Recent Auth",
            "type": "boolean"
          },
          "scopes": {
            "items": {
              "$ref": "#/components/schemas/ScopeOut"
            },
            "title": "Scopes",
            "type": "array"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "user_id",
          "email",
          "name",
          "verified",
          "account_state",
          "membership_state",
          "mfa_required",
          "recent_auth",
          "grant_epoch",
          "active_scope",
          "active_grants",
          "memberships",
          "capabilities",
          "scopes",
          "expires_at"
        ],
        "title": "MeOut",
        "type": "object"
      },
      "RegisterInput": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 6,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "email",
          "name"
        ],
        "title": "RegisterInput",
        "type": "object"
      },
      "RegistrationOut": {
        "properties": {
          "simulator_challenge": {
            "title": "Simulator Challenge",
            "type": "string"
          },
          "status": {
            "const": "verification_required",
            "default": "verification_required",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "simulator_challenge"
        ],
        "title": "RegistrationOut",
        "type": "object"
      },
      "ScopeOut": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "institution_id": {
            "format": "uuid",
            "title": "Institution Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          }
        },
        "required": [
          "id",
          "institution_id",
          "name",
          "kind",
          "timezone"
        ],
        "title": "ScopeOut",
        "type": "object"
      },
      "StatusOut": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
