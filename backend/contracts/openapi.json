        "title": "StatusOut",
        "type": "object"
      },
      "VerifyInput": {
        "additionalProperties": false,
        "properties": {
          "challenge": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Challenge",
            "type": "string"
          }
        },
        "required": [
          "challenge"
        ],
        "title": "VerifyInput",
        "type": "object"
      }
    }
